[{"id":1266430423682310145,"date":1590775516000,"rawContent":"Say it, @ladygaga \n\nSay #BlackLivesMatter","userId":3190271899,"media":null,"username":"marcus_ismael","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":1.0,"sumOfBlackLivesMatter":19,"sumOfBlueLivesMatter":1,"sumOfMeToo":0,"sumOfClimate":1,"rollingSumOfBlackLivesMatter":1.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":1268754792756572160,"date":1591329689000,"rawContent":"Our city has been so alive lately! I\u2019m proud it\u2019s because we\u2019re all standing up to say #BlackLivesMatter","userId":3190271899,"media":null,"username":"marcus_ismael","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":2.0,"sumOfBlackLivesMatter":20,"sumOfBlueLivesMatter":1,"sumOfMeToo":0,"sumOfClimate":1,"rollingSumOfBlackLivesMatter":2.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":1270833006027005953,"date":1591825174000,"rawContent":"Fellow Asian Americans, you cannot truly utter the words #BlackLivesMatter and mean it with all your heart if you continue to oppose affirmative action in California. We\u2019ve gone 24 years w\/out it and minorities and women have suffered as a result. Time to bring it back. #ACA5","userId":3190271899,"media":null,"username":"marcus_ismael","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":3.0,"sumOfBlackLivesMatter":21,"sumOfBlueLivesMatter":1,"sumOfMeToo":0,"sumOfClimate":1,"rollingSumOfBlackLivesMatter":3.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":1271879555641249793,"date":1592074691000,"rawContent":"I\u2019m not hearing anything from the civility crowd today about how bad doxxing is when it\u2019s currently taking down a white lady\u2019s skincare line because she harassed a black homeowner in San Francisco for writing #BlackLivesMatter on his own property. Keep it up, y\u2019all.","userId":3190271899,"media":null,"username":"marcus_ismael","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":4.0,"sumOfBlackLivesMatter":22,"sumOfBlueLivesMatter":1,"sumOfMeToo":0,"sumOfClimate":1,"rollingSumOfBlackLivesMatter":4.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":1272205711674507265,"date":1592152452000,"rawContent":"When it riles up white people and makes them so uncomfortable they want to change it or have it \u201cbetter defined\u201d - the same way they reacted to #BlackLivesMatter years ago - then yes we know it\u2019s good.","userId":3190271899,"media":null,"username":"marcus_ismael","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":5.0,"sumOfBlackLivesMatter":23,"sumOfBlueLivesMatter":1,"sumOfMeToo":0,"sumOfClimate":1,"rollingSumOfBlackLivesMatter":5.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":1272428119631118336,"date":1592205478000,"rawContent":"I have never, not once in my life seen the Bay Bridge held up like this. I think the closest thing was 580 shut down years ago. This is incredible, beautiful, and absolutely necessary. Thank you to these protestors for showing up to say #BlackLivesMatter","userId":3190271899,"media":null,"username":"marcus_ismael","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":6.0,"sumOfBlackLivesMatter":24,"sumOfBlueLivesMatter":1,"sumOfMeToo":0,"sumOfClimate":1,"rollingSumOfBlackLivesMatter":6.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":1272547499459268610,"date":1592233941000,"rawContent":"We need to carry ON*\n\nIf we in the #LGBTQ present ourselves as forward thinking progressives because it means advancement for our lives, we need to show up for the communities in our society who also deserve to thrive. Today is a reminder for solidarity. #BlackLivesMatter","userId":3190271899,"media":null,"username":"marcus_ismael","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":7.0,"sumOfBlackLivesMatter":25,"sumOfBlueLivesMatter":1,"sumOfMeToo":0,"sumOfClimate":1,"rollingSumOfBlackLivesMatter":7.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0}]