[{"id":1490821516929519624,"date":1644274522000,"rawContent":"Those of us working through the past need more love than we know. #selflove #ChildhoodTrauma #metoo #abused #SURVIVE https:\/\/t.co\/REE3zNPHS1","userId":1490004567974719490,"media":["https:\/\/pbs.twimg.com\/media\/FLB14uiWUAM6bTf?format=jpg&name=orig"],"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":1.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":1,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":1.0,"rollingSumOfClimate":0.0},{"id":1491121887338176512,"date":1644346136000,"rawContent":"Quick Exit - a function most victim resource websites have - with one quick click the page, the cookie and any digital trace of the visit is gone. #safespace #MeToo #DomesticAbuse #helpishere","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":2.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":2,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":2.0,"rollingSumOfClimate":0.0},{"id":1491924552858939392,"date":1644537506000,"rawContent":"I\u2019ve been hiding from my victim hood for too long. We grow when we reach out and CHOOSE to grow instead of hiding who we are in favour of societal norms #emotionalabuse #survivor #childhoodtrauma #growth #metoo","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":3.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":3,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":3.0,"rollingSumOfClimate":0.0},{"id":1494656457962401805,"date":1645188843000,"rawContent":"\"When they figured out I'd been keeping pictures and screenshotting texts of the abuse. They didn't stop, they got smarter\u201d - survivor of emotional abuse\nhttps:\/\/t.co\/IO9AYMRdlO\n#SURVIVE #AbuseHasNoGender #emotionalhealth #metoo #SafeHaven https:\/\/t.co\/MZdn240eul","userId":1490004567974719490,"media":["https:\/\/pbs.twimg.com\/media\/FL4WIHpX0AA-gEL?format=jpg&name=orig","https:\/\/pbs.twimg.com\/media\/FL4WIH9X0AUnZzx?format=jpg&name=orig"],"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":4.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":4,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":4.0,"rollingSumOfClimate":0.0},{"id":1495018843642732545,"date":1645275243000,"rawContent":"\u201cI\u2019ve tried to leave the house, you know to take a walk. But they\u2019d leave first so I couldn\u2019t because someone has to stay with the kids.\u201d \u2013 survivor of emotional abuse.\nhttps:\/\/t.co\/7nEhMvTdyG \n#SURVIVE #AbuseHasNoGender #emotionalhealth #metoo #SafeHaven https:\/\/t.co\/ZsMIQx4YkD","userId":1490004567974719490,"media":["https:\/\/pbs.twimg.com\/media\/FL9ftx7XEA0XAAp?format=jpg&name=orig"],"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":5.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":5,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":5.0,"rollingSumOfClimate":0.0},{"id":1495381223564361728,"date":1645361641000,"rawContent":"Have you ever been berated into letting go of your dreams because the person you\u2019re with doesn\u2019t think it\u2019s a good idea? #thatmaybeabuse #SURVIVE #AbuseHasNoGender #emotionalhealth #metoo #SafeHaven #semicolon","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":6.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":6,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":6.0,"rollingSumOfClimate":0.0},{"id":1497193165085941792,"date":1645793641000,"rawContent":"Just because they\u2019ve filled their cup through abuse doesn\u2019t mean your cup is empty; It\u2019s just got a hole drilled through and leaking. You matter. There\u2019s hope. There\u2019s help. \n\n#emotionalhealth #strength #power #survivor #domesticabuse #emotionalabuse #gaslighting #metoo","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":7.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":7,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":7.0,"rollingSumOfClimate":0.0},{"id":1497948330420224002,"date":1645973687000,"rawContent":"Words can be daggers stabbing our souls til they bleed. But, wounds can heal. Trauma can be healed. #emotionalabuse #MeToo #SundayMotivation","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":8.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":8,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":8.0,"rollingSumOfClimate":0.0},{"id":1498275039531126789,"date":1646051580000,"rawContent":"It\u2019s not your job to break their pattern. It takes immeasurable strength and comes at great emotional cost to change. Leaving is the easy part. \nYou\u2019re not alone. There is hope. There is help. \n#DomesticAbuse #emotionalhealth #MeToo #Healing","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":9.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":9,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":9.0,"rollingSumOfClimate":0.0},{"id":1498475731126468612,"date":1646099429000,"rawContent":"Myth: People can\u2019t change \n\nReality: Survivors change every day. We wake up and choose to overcome and literally adjust the synapsis  in our brain to move from coping to thriving past trauma. \n#emotionalhealth #metoo #emotionalabuse #mentalhealth #DomesticAbuse #Survive","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":10.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":10,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":10.0,"rollingSumOfClimate":0.0},{"id":1500099846102990852,"date":1646486648000,"rawContent":"Never let anyone define your trauma or your truth. \nIt\u2019s yours. \nYour story\nYour trauma \nYour way.\n#mentalhealthmatters #metoo","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":11.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":11,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":11.0,"rollingSumOfClimate":0.0},{"id":1502387367403008005,"date":1647032036000,"rawContent":"We don\u2019t always when know when we\u2019re trapped until we\u2019re locked behind a door. \n\nRemember - doors open, even when humidity swells the wood and traps you in. \n\n#FightBackFriday #MentalHealthMatters #MeToo","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":10.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":12,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":10.0,"rollingSumOfClimate":0.0},{"id":1502506381282365448,"date":1647060411000,"rawContent":"Cry Therapy: The house is quiet\nWe take a number of breaths\n\nNow just let go\nJust cry. Don\u2019t think, just cry.\nIt gets worse before it gets better\n#RELEASE #MeToo #MentalHealthMatters #therapy","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":11.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":13,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":11.0,"rollingSumOfClimate":0.0},{"id":1502663154173685762,"date":1647097788000,"rawContent":"Let\u2019s normalize ourselves as survivors instead of victims. \nI survived sexual abuse\nI survived domestic violence\nI survived emotional abuse\nI survived. \nI am not a victim but I am a survivor\n#metoo #mentallwellness #survive","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":12.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":14,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":12.0,"rollingSumOfClimate":0.0},{"id":1503087896739389449,"date":1647199055000,"rawContent":"Survivors don\u2019t have trouble trusting, we just have better bs monitors so we know when to walk. \n#WalkAway #Independent #metoo #mentalhealth","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":12.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":15,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":12.0,"rollingSumOfClimate":0.0},{"id":1503700292541501445,"date":1647345061000,"rawContent":"How we process pain and hurt dictates how deep the scar on our soul will be\n\n#grief #mentalhealth #metoo #selflove","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":13.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":16,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":13.0,"rollingSumOfClimate":0.0},{"id":1504435229989261320,"date":1647520284000,"rawContent":"Some have said those who\u2019ve experienced abuse lack coping mechanisms but we say - uuummm, then why we still here? Takes nothing but strength and coping to get to a place of calm\n#metoo  #coping #dvsurvivor #MentalHealthAwareness","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":14.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":17,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":14.0,"rollingSumOfClimate":0.0},{"id":1504812655948800027,"date":1647610269000,"rawContent":"Even quieted voices can be heard once more. A voice that was once lost can be found again. #strength #metoo #MentalHealthMatters #abused #thursdayvibes","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":15.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":18,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":15.0,"rollingSumOfClimate":0.0},{"id":1505348183660150785,"date":1647737949000,"rawContent":"It\u2019s easy to feel guilty while healing. We feel like we\u2019re not doing enough \nEnough for ourselves\nEnough for family\nEnough for our friends\nHealing is enough\n#MentalHealthMatters #YouMatter #survive #heal #MeToo","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":16.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":19,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":16.0,"rollingSumOfClimate":0.0},{"id":1505599445576171522,"date":1647797855000,"rawContent":"We cannot prevent triggers from our past but we can safeguard our souls for the future \n#sundayvibes #triggerwarning #MentalHealthMatters #mentalwellnes #MeToo","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":16.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":20,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":16.0,"rollingSumOfClimate":0.0},{"id":1505675089332875267,"date":1647815890000,"rawContent":"It\u2019s normal for people who\u2019ve been abused to over apologize, we\u2019re not apologizing to you. We\u2019re apologizing to ourselves and have misplaced the words. \n#metoo #MentalHealthMatters #survive #strive #Growth","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":17.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":21,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":17.0,"rollingSumOfClimate":0.0},{"id":1506475171686797314,"date":1648006644000,"rawContent":"How do you deal with triggers? \n\n20+ yrs and certain people, certain smells, certain sites. \n\nHits me like a rock slamming my insides and pushing me back to that place. \n\nThen I\u2019m thrown, rolling down the mountain while it all slices me again  \n#MeToo #PTSD","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":16.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":22,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":16.0,"rollingSumOfClimate":0.0},{"id":1506616374151589897,"date":1648040309000,"rawContent":"Reflections - \nin a mirror, that I can\u2019t stand\nIn myself from which I can not grow\nIn others where only envy thrives\nIn the normalcy I\u2019ll never have\n#metoo #reflections #wednesdaythought #mentalhealth","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":17.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":23,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":17.0,"rollingSumOfClimate":0.0},{"id":1506951193054126080,"date":1648120136000,"rawContent":"Mirrors are challenging cause I rarely see the person I want reflected back at me\n#bodyimage #metoo #ThursdayThoughts #surviving #REFLECTION","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":18.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":24,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":18.0,"rollingSumOfClimate":0.0},{"id":1507541489278140420,"date":1648260874000,"rawContent":"Never hesitate to have a grief checkin - at a party with friends, before leaving family. \nIf they need it\nIf you need it\nJust check in.\nTalk about how much you love those you miss\nTalk about how sad you are\nWere \nMay Be. \nCheck in, we\u2019re listening \n#grief #FridayThoughts #MeToo","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":19.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":25,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":19.0,"rollingSumOfClimate":0.0},{"id":1507873197999468550,"date":1648339959000,"rawContent":"It takes two to fight but only one to walk away \n#Fights #MentalHealthMatters #thrive #metoo #bethechange","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":20.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":26,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":20.0,"rollingSumOfClimate":0.0},{"id":1507876910495371271,"date":1648340845000,"rawContent":"It\u2019s easy for those of us who have been abused to take on others grief in times of trouble. But you don\u2019t need too. It\u2019s the trigger not the gun. #breathe #Grief #metoo #MentalHealthAwareness #strength","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":21.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":27,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":21.0,"rollingSumOfClimate":0.0},{"id":1508160300712972292,"date":1648408410000,"rawContent":"You can change. \nEveryone is capable but not all believe it\u2019s a choice for the better\nYou can change \n#change #growth #metoo #sundayvibes #mentalhealth #PTSD","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":21.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":28,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":21.0,"rollingSumOfClimate":0.0},{"id":1508268758934208514,"date":1648434269000,"rawContent":"Talking matters\nOur stories\nOur truths\nThat\u2019s our power \nbut our weakness\nOur stories are true\nOur truths are sorrowful\nBut those stories are strength\nTalking matters\n#MeToo #MentalHealthMatters #PTSD","userId":1490004567974719490,"media":null,"username":"Abusesurvivors5","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":22.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":29,"sumOfClimate":0,"roll