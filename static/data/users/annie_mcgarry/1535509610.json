[{"id":1034628410067300352,"date":1535509610000,"rawContent":"@rainbowhill1994 @ashboos @hillarykwiatek @Caissie Yes, 45 re-traumatized us. Before trump, I felt that I had healed my wounds better than I had. So that was disappointing, too. I had been proud of myself for healing as well as I had, or thought I had. The recovery continues, and reading y\u2019all\u2019s stories and insights helps. #MeToo","userId":840926539,"media":null,"username":"annie_mcgarry","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":1.0,"sumOfBlackLivesMatter":1,"sumOfBlueLivesMatter":0,"sumOfMeToo":13,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":1.0,"rollingSumOfClimate":0.0},{"id":1039650719954075649,"date":1536707022000,"rawContent":"@mistahg11 @MarisaKabas @normmacdonald No, because he said that the victims didn\u2019t have to go through what the perpetrator did. He also said that the #MeToo movement is slowing down, and he\u2019s glad. There\u2019s too little understanding of what victims of sexual abuse go through: suicide attempts, PTSD, depression, anxiety.","userId":840926539,"media":null,"username":"annie_mcgarry","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":2.0,"sumOfBlackLivesMatter":1,"sumOfBlueLivesMatter":0,"sumOfMeToo":14,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":2.0,"rollingSumOfClimate":0.0},{"id":1041794741875167234,"date":1537218196000,"rawContent":"@bhansen2580 @virginiahume #metoo \u2764\ufe0f\ud83d\udc94\u2764\ufe0f\ud83d\udc94\u2764\ufe0f\ud83d\udc94\u2764\ufe0f","userId":840926539,"media":null,"username":"annie_mcgarry","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":3.0,"sumOfBlackLivesMa