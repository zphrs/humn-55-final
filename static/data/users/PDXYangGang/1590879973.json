[{"id":1266868545557639168,"date":1590879973000,"rawContent":"The death of George Floyd is a tragic event that never should have happened, but putting your life or your freedom on the line because you're frustrated and angry isn't worth it. There is so much that you can do above ground, and on this side of prison bars. \n\n#BlackLivesMatter","userId":1105621009795670016,"media":null,"username":"PDXYangGang","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":1.0,"sumOfBlackLivesMatter":1,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":2,"rollingSumOfBlackLivesMatter":1.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":1267878892863254528,"date":1591120858000,"rawContent":"We stand with you.\n\nUnessecary police brutality has no place in our society.\n#BlackLivesMatter #BlackOutTuesdsy","userId":1105621009795670016,"media":null,"username":"PDXYangGang","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":2.0,"sumOfBlackLivesMatter":2,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":2,"rollingSumOfBlackLivesMatter":2.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":1269132284822601728,"date":1591419690000,"rawContent":"@tedwheeler, you need to do better man. Education is vitally important, but that doesn't address the teargassing, or the acts of police brutality that the @PortlandPolice have inflicted on the citizens of this great city.\n\nDo better. #BlackLivesMatter","userId":1105621009795670016,"media":null,"username":"PDXYangGang","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":3.0,"sumOfBlackLivesMatter":3,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":2,"rollingSumOfBlackLivesMatter":3.0,"rollingSumOfBlueLivesMa