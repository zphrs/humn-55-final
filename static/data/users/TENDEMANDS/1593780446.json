[{"id":1279034012036739077,"date":1593780446000,"rawContent":"\u201cI\u2019m tired. I\u2019m tired of crying at every injustice. I\u2019m tired of being angry. I\u2019m tired of feeling helpless. I\u2019m tired of living in fear. This moment in time calls for drastic steps. This is what #TenForJustice offers.\u201d\n\n- @EPetronaC, @TENDEMANDS co-founder\n\n#BlackLivesMatter https:\/\/t.co\/nhYKp0u1kA","userId":1256369286135910402,"media":["https:\/\/pbs.twimg.com\/media\/EcAKp0FXsAAHheT?format=jpg&name=orig"],"username":"TENDEMANDS","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":1.0,"sumOfBlackLivesMatter":1,"sumOfBlueLivesMatter":0,"sumOfMeToo":1,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":1.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":1285594502573563904,"date":1595344589000,"rawContent":"\"Radicalism is the basic belief that humans should not have to beg to have all our needs met equally. This 10 point plan is radical and I want us all to live.\"\n\n- @KieseLaymon, Endorser, #TenForJustice \n\nhttps:\/\/t.co\/cZNOcHlwKm\n\n#BlackLivesMatter https:\/\/t.co\/UZfzMFXC3D","userId":1256369286135910402,"media":["https:\/\/pbs.twimg.com\/media\/EddZYcRXsAAJYi_?format=jpg&name=orig"],"username":"TENDEMANDS","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":2.0,"sumOfBlackLivesMatter":2,"sumOfBlueLivesMatter":0,"sumOfMeToo":1,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":2.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":1286658564946374660,"date":1595598281000,"rawContent":"\"We need all hands on deck to work overtime to frame a new American criminal legal system, and this is a step in the direction of that change.\"\n\n- @LouislReed, National Organizer, @cut_50, on #TenForJustice\n\n(our own @AWKWORDrap w