[{"id":1045178794749845504,"date":1538025017000,"rawContent":"I'm so tired of all those tired #MeToo jokes. \"Haha, I can't say anything offensive about women now, haha\". It's not funny, interesting, provocative, just plain stupid.","userId":50262686,"media":null,"username":"mathiaspoulsen","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":1.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":31,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":1.0,"rollingSumOfClimate":0.0},{"id":1045909600162074625,"date":1538199255000,"rawContent":"\"Has #MeToo\u2060 \u2060 gone too far\" many men ask. The answer is no, it hasn't nearly gone far enough. It must continue &amp; grow even stronger. The power of patriarchy seems to be much too deeply rooted.","userId":50262686,"media":null,"username":"mathiaspoulsen","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":2.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":32,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":2.0,"rollingSumOfClimate":0.0},{"id":1049328899270889474,"date":1539014479000,"rawContent":"@Kong_Kret @labeet @EkstraBladet I \u00f8vrigt sidder min k\u00e6re k\u00e6reste @Reestorff, som en del af hendes forskning, og unders\u00f8ger (et udsnit af) #dkmedier's (vist is\u00e6r DRs) d\u00e6kning af #metoo. Det er ikke ligefrem noget, man kommer i bedre hum\u00f8r af.","userId":50262686,"media":null,"username":"mathiaspoulsen","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":3.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":33,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"r