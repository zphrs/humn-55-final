[{"id":920067101368479744,"date":1508196065000,"rawContent":"#MeToo shouldn't have been the eye-opener it was.\n\nGuys, this is on us.\n\n#NotMe","userId":3311036150,"media":null,"username":"HMAesq","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":1.0,"sumOfBlackLivesMatter":21,"sumOfBlueLivesMatter":3,"sumOfMeToo":1,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":1.0,"rollingSumOfClimate":0.0},{"id":921770212227248128,"date":1508602118000,"rawContent":"Reporting misconduct in your own community strengthens it, not weakens it. #MeToo","userId":3311036150,"media":null,"username":"HMAesq","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":2.0,"sumOfBlackLivesMatter":21,"sumOfBlueLivesMatter":3,"sumOfMeToo":2,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":2.0,"rollingSumOfClimate":0.0},{"id":926906568918093824,"date":1509826721000,"rawContent":"#MeToo was also about the fear behind reporting sexual assault. This victim is confronted by a hostile immigration officer in 45's America: https:\/\/t.co\/iI4mENwbF9","userId":3311036150,"media":null,"username":"HMAesq","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":3.0,"sumOfBlackLivesMatter":21,"sumOfBlueLivesMatter":3,"sumOfMeToo":3,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":3.0,"rollingSumOfClimate":0.0},{"id":928750273765486592,"date":1510266295000,"rawContent":"@DonCheadle @GOP White nationalism at work. Poor &amp; vulnerable nearly always means POC. And sexual assault was forgivable for so long until #MeToo.","userId":3311036150,"media":null,"username":"HMAesq","containsBlackLivesMatter":false,