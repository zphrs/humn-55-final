ingSumOfMeToo":20.0,"rollingSumOfClimate":0.0},{"id":961968484711153664,"date":1518186133000,"rawContent":"We need to center the experiences of marginalized communities in order to broaden &amp; strengthen our solutions to end sexual violence. \u2014@SafeSpacesDC's @thejessicaraven at \"Men &amp; the #MeToo Movement\"","userId":2168815104,"media":null,"username":"equimundo_org","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":21.0,"sumOfBlackLivesMatter":1,"sumOfBlueLivesMatter":0,"sumOfMeToo":28,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":21.0,"rollingSumOfClimate":0.0},{"id":961971333771997185,"date":1518186813000,"rawContent":"We need institutional leadership to end sexual violence. It needs to be a social justice imperative. \u2014@jacksontkatzat at \"Men &amp; the #MeToo Movement\"","userId":2168815104,"media":null,"username":"equimundo_org","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":22.0,"sumOfBlackLivesMatter":1,"sumOfBlueLivesMatter":0,"sumOfMeToo":29,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":22.0,"rollingSumOfClimate":0.0},{"id":961971965119680513,"date":1518186963000,"rawContent":"\"To stop this issue &amp; to be more progressive on harassment, we need to start with adolescents.\" \u2014@being_ianta at \"Men &amp; the #MeToo Movement\" @VitalVoices @NewAmerica","userId":2168815104,"media":null,"username":"equimundo_org","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":23.0,"sumOfBlackLivesMatter":1,"sumOfBlueLivesMatter":0,"sumOfMeToo":30,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":23.0,"rollingSumOfClimate":0.0},{"id":961974261995982848,"date":1518187511000,"rawContent":"We're live with @VitalVoices @NewAmerica @BetterLifeLab talking about \"Men and the #MeToo Movement.\" Watch here: https:\/\/t.co\/AEiyhpcSjC","userId":2168815104,"media":null,"username":"equimundo_org","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":24.0,"sumOfBlackLivesMatter":1,"sumOfBlueLivesMatter":0,"sumOfMeToo":31,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":24.0,"rollingSumOfClimate":0.0},{"id":961978841039241216,"date":1518188603000,"rawContent":"\"It\u2019s really important that we take a critical look at the media &amp; how different folks\u2019 narratives [about sexual assault] are being told.\" \u2014@aelizabethclark @endrapeoncampus at \"Men &amp; the #MeToo Movement\"","userId":2168815104,"media":null,"username":"equimundo_org","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":25.0,"sumOfBlackLivesMatter":1,"sumOfBlueLivesMatter":0,"sumOfMeToo":32,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":25.0,"rollingSumOfClimate":0.0},{"id":961980617943670784,"date":1518189026000,"rawContent":"\"This is a moment in which men can do two things: 1 \u2013 We have to listen to women. 2 \u2013 If we're going to start listening to women, we also need to start talking to other men.\" \u2014@MichaelS_Kimmel at \"Men &amp; the #MeToo Movement\"","userId":2168815104,"media":null,"username":"equimundo_org","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":26.0,"sumOfBlackLivesMatter":1,"sumOfBlueLivesMatter":0,"sumOfMeToo":33,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":26.0,"rollingSumOf