r. \n\nWe\u2019re working to change that. \n#blacklivesmatter \n\n#blackhistorymonth @NAACP @NAACPmpls @TheBlackCaucus @JoeBiden @VP https:\/\/t.co\/KgaBlFm1uj","userId":1030148441043816448,"media":["https:\/\/pbs.twimg.com\/media\/FMkNUp8XoAEmKPy?format=jpg&name=orig"],"username":"JohnMasonMN","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":4.0,"sumOfBlackLivesMatter":31,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":4.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0}]