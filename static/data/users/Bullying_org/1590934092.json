"containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":4.0,"sumOfBlackLivesMatter":4,"sumOfBlueLivesMatter":0,"sumOfMeToo":12,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":4.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1272331581336649729","date":1592182462000,"rawContent":"#BlackLivesMatter is a Human Rights issue.\n\nCountries have human rights laws to make sure that people &amp; governments are held accountable if your human rights are not respected. In Canada, your human rights are protected by provincial, territorial, federal &amp; international law. 3\/3","media":null,"username":"Bullying_org","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":5.0,"sumOfBlackLivesMatter":5,"sumOfBlueLivesMatter":0,"sumOfMeToo":12,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":5.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0}]