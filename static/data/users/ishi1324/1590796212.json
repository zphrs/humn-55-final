esMatter \n\n@KnightsShade64 @SonicLink125 @JustZachary7 @TheNCSmaster @Ribustol","media":null,"username":"ishi1324","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":3.0,"sumOfBlackLivesMatter":3,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":3.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1278202781061599232","date":1593582265000,"rawContent":"and just like that, pride month is over. It was dominated by BLM this year, but none of us lost our shit over it, because we're mature and know from experience that riots get results. #BlackLivesMatter","media":null,"username":"ishi1324","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":3.0,"sumOfBlackLivesMatter":4,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":3.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0}]