een","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":7.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":31,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":7.0,"rollingSumOfClimate":0.0},{"id":1004121530266202113,"date":1528236203000,"rawContent":"However the shame and guilt still stayed with me and I wasn't really over it #abuse #MeToo","userId":199582794,"media":null,"username":"Youngafriqueen","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":8.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":32,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":8.0,"rollingSumOfClimate":0.0},{"id":1004121535500685312,"date":1528236204000,"rawContent":"I was failing to come to terms with it because somehow I felt like an accomplice to my own abuse (weird I know) #abuse #MeToo","userId":199582794,"media":null,"username":"Youngafriqueen","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":9.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":33,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":9.0,"rollingSumOfClimate":0.0},{"id":1004121541385293825,"date":1528236205000,"rawContent":"I romanticized my abuse, probably as a copying strategy, to make me less of a victim and it worked for years #metoo #abuse","userId":199582794,"media":null,"username":"Youngafriqueen","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":10.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":34,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"roll