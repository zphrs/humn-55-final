[{"id":1115390119077339136,"date":1554764701000,"rawContent":"\"You trust them, and I don't. You studied what he wanted you to learn about him in schools. I studied him in the streets and in prison, where you see the truth.\" #MalcolmX #BlackLivesMatter https:\/\/t.co\/MK9odYpxNJ","userId":314232881,"media":["https:\/\/pbs.twimg.com\/media\/D3qpZlZUUAEklT9?format=jpg&name=orig"],"username":"Malcolm_X_Files","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":1.0,"sumOfBlackLivesMatter":115,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":1.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":1115755123530031110,"date":1554851725000,"rawContent":"\"You get freedom by letting your enemy know that you'll do anything to get your freedom; then you'll get it. It's the only way you'll get it.\" #MalcolmX #BlackLivesMatter https:\/\/t.co\/Tr1kJmqYUH","userId":314232881,"media":["https:\/\/pbs.twimg.com\/media\/D3v1XU3UUAA79Qj?format=jpg&name=orig"],"username":"Malcolm_X_Files","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":2.0,"sumOfBlackLivesMatter":116,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":2.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":1117021850041638913,"date":1555153736000,"rawContent":"\"I\u2019m not an American. I\u2019m one of the 22 million black people who are the victims of Americanism. One of the 22 million black people who are the victims of democracy. I don\u2019t see any American dream, I see an American nightmare.\" #MalcolmX #BlackLivesMatter https:\/\/t.co\/TWXISM2Qyf","userId":314232881,"media":["https:\/\/pbs.twimg.com\/media\/D4B1cwcU0AABgJT?format=jpg&name=orig"],"username":"Malcolm_X_Files","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":3.0,"sumOfBlackLivesMatter":117,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":3.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":1118315588751773696,"date":1555462188000,"rawContent":"There can be no black-white unity until there is first  black unity. We cannot think of uniting with others, until  we have first united among ourselves. We cannot think of being acceptable to others until we have first proven acceptable to ourselves. #MalcolmX #BlackLivesMatter https:\/\/t.co\/XReLnWumT4","userId":314232881,"media":["https:\/\/pbs.twimg.com\/media\/D4UOFoHUYAAHy0m?format=jpg&name=orig"],"username":"Malcolm_X_Files","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":4.0,"sumOfBlackLivesMatter":118,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":4.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":1119653397051744256,"date":1555781146000,"rawContent":"\"We are African, and we happen to be in America. We're not American. We are people who formerly were Africans who were kidnapped and brought to America. Our forefathers weren't the Pilgrims. We didn't land on Plymouth Rock. The rock was landed on us.\" #MalcolmX #BlackLivesMatter https:\/\/t.co\/qoKmofZDB7","userId":314232881,"media":["https:\/\/pbs.twimg.com\/media\/D4nO0_wUUAAYhmd?format=jpg&name=orig"],"username":"Malcolm_X_Files","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":5.0,"sumOfBlackLivesMatter":119,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":5.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":1121224234775138304,"date":1556155663000,"rawContent":"\"I've had enough of someone else's propaganda. I'm for truth, no matter who tells it. I'm for justice, no matter who it's for or against. I'm a human being first and foremost, and as such I am for whoever and whatever benefits humanity as a whole.\" #MalcolmX #BlackLivesMatter https:\/\/t.co\/5rhOJg2fw5","userId":314232881,"media":["https:\/\/pbs.twimg.com\/media\/D49jfydUUAA3TBs?format=jpg&name=orig"],"username":"Malcolm_X_Files","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":6.0,"sumOfBlackLivesMatter":120,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":6.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":1123040665934286848,"date":1556588734000,"rawContent":"\"Black people are fed up with the dillydallying, pussyfooting, compromising approach that we\u2019ve been using toward getting our freedom. We want freedom now, but we\u2019re not going to get it saying \u201cWe Shall Overcome.\u201d We\u2019ve got to fight until we overcome.\" #MalcolmX #BlackLivesMatter https:\/\/t.co\/l8l5e5s6x7","userId":314232881,"media":["https:\/\/pbs.twimg.com\/media\/D5XXhpSUUAIGptp?format=jpg&name=orig"],"username":"Malcolm_X_Files","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":7.0,"sumOfBlackLivesMatter":121,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":7.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":1124078849552044032,"date":1556836256000,"rawContent":"\"I believe in a religion that believes in freedom. Any time I have to accept a religion that won't let me fight a battle for my people, I say to hell with that religion.\" #MalcolmX #BlackLivesMatter https:\/\/t.co\/nFhcUfBqnL","userId":314232881,"media":["https:\/\/pbs.twimg.com\/media\/D5mHvwgW4AImjaZ?format=jpg&name=orig"],"username":"Malcolm_X_Files","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":8.0,"sumOfBlackLivesMatter":122,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":8.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":1125961452244758528,"date":1557285104000,"rawContent":"Education is an important element in the struggle for human rights. Education is our passport to the future, for tomorrow belongs only to the people who prepare for it today. \n\n#MalcolmX #BlackLivesMatter https:\/\/t.co\/aJpYef8JQL","userId":314232881,"media":["https:\/\/pbs.twimg.com\/media\/D6A39-KUIAEvKci?format=jpg&name=orig"],"username":"Malcolm_X_Files","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":9.0,"sumOfBlackLivesMatter":123,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":9.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":1130134316422451201,"date":1558279992000,"rawContent":"Happy Malcolm X Day! #MalcolmX #BlackLivesMatter https:\/\/t.co\/YPY1LVHWth","userId":314232881,"media":["https:\/\/pbs.twimg.com\/media\/D68LK3FXsAA1pBQ?format=jpg&name=orig"],"username":"Malcolm_X_Files","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":6.0,"sumOfBlackLivesMatter":124,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":6.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":1133331538786082817,"date":1559042269000,"rawContent":"#MalcolmX #BlackLivesMatter \n\nhttps:\/\/t.co\/MzgVCOksUT https:\/\/t.co\/2D1S54rf1