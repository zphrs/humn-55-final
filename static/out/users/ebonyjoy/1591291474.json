[{"id":"1268594506141782016","date":1591291474000,"rawContent":"To those complaining about the video of the little girl protesting, let her voice be heard. I\u2019ve been an educator for almost twenty years now and the consistent message from my students is they hate being lied to and ignored. #BlackLivesMatter","userId":14446278,"media":null,"username":"ebonyjoy","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":1.0,"sumOfBlackLivesMatter":45,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":1,"rollingSumOfBlackLivesMatter":1.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1268594507135823872","date":1591291474000,"rawContent":"Every student who leaves my classroom knows their voice has value and should be heard. Should this little one have to protest? Absolutely not. Would we rather that she be playing with toys and learning that the world is a safe place? Absolutely. #BlackLivesMatter","userId":14446278,"media":null,"username":"ebonyjoy","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":2.0,"sumOfBlackLivesMatter":46,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":1,"rollingSumOfBlackLivesMatter":2.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1268594508276461568","date":1591291474000,"rawContent":"But this is our reality now. And she will hear about what\u2019s happening whether those around her tell her or not. #BlackLivesMatter","userId":14446278,"media":null,"username":"ebonyjoy","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":3.0,"sumOfBlackLivesMatter":47,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":1,"rollingSumOfBlackLivesMatter":3.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"