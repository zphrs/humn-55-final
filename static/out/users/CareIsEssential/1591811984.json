[{"id":"1270777685892108288","date":1591811984000,"rawContent":"Carmen Roberts, a home care worker &amp; inspirational member leader of @SEIU2015, took part in today's @SEIU Walkout Wednesday. Here are her remarks on delivering quality care while fighting against systemic racism &amp; #COVID19. #BlackLivesMatter https:\/\/t.co\/T4TC8hvABh","userId":3265525321,"media":["https:\/\/pbs.twimg.com\/media\/EaKzFF1XkAgq90x?format=jpg&name=orig"],"username":"CareIsEssential","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":1.0,"sumOfBlackLivesMatter":8,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":1.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1270777692208738304","date":1591811986000,"rawContent":"\u201cI\u2019m excited about the progress we\u2019ve made in getting more PPE distributed to home-care providers, but I\u2019m honestly just as excited if not more excited about the progress we\u2019re making in the fight for racial justice.\u201d #ProtectAllWorkers #BlackLivesMatter","userId":3265525321,"media":null,"username":"CareIsEssential","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":2.0,"sumOfBlackLivesMatter":9,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":2.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1270777694658142210","date":1591811986000,"rawContent":"\u201cHomecare workers have not been viewed as workers in the same way as carpenters, teachers &amp; even police officers. Our work is not valued in the same way because our members perform the same duties enslaved women did in this country for centuries.\u201d #BlackLivesMatter","userId":3265525321,"media":null,"username":"CareIsEssential","containsBlackLivesMatter":tr