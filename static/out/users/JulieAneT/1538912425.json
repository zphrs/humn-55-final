[{"id":"1048900851325132800","date":1538912425000,"rawContent":"#metoo #VictimBlaming bis zum \u00c4u\u00dfersten \nWie kann jmd. zu Potenz und #Macht gelangen, wenn Machtstrukturen und #Machtmissbrauch nicht sichtbar gemacht werden (und es geht hier nicht ausschlie\u00dflich um M\u00e4nner, die Macht missbrauchen).\nhttps:\/\/t.co\/4QFTgQ1U8r","userId":108068653,"media":null,"username":"JulieAneT","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":1.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":17,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":1.0,"rollingSumOfClimate":0.0},{"id":"1048905416170717185","date":1538913513000,"rawContent":"#metoo #Fla\u00dfp\u00f6hler Wenn man Machtmissbrauchsstrukturen nicht sichtbar macht, bleiben Menschen, die sich diesem System nicht anpassen, oft relativ machtlos (und damit sind nicht ausschlie\u00dflich Frauen gemeint und es geht auch nicht nur um sexuelle, ebenso um psychische Gewalt).","userId":108068653,"media":null,"username":"JulieAneT","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":2.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":18,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":2.0,"rollingSumOfClimate":0.0},{"id":"1048911599388450816","date":1538914987000,"rawContent":"#metoo #Fla\u00dfp\u00f6hler \nBei Menschen, die missbraucht wurden (egal ob k\u00f6rperlich, sexuell oder psychisch) bedarf es meist tiefgehender (psychotherapeutischer) Arbeit, damit diese sich aus ihrer Erstarrung l\u00f6sen k\u00f6nnen und ihre Handlungsoptionen\/ihre Potenz (wieder-)erkennen.","userId":108068653,"media":null,"username":"JulieAneT","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":3.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":19,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":3.0,"rollingSumOfClimate":0.0},{"id":"1048912028872716289","date":1538915090000,"rawContent":"#metoo \nDas Sichtbarmachen und Skandalisieren (auch \u00fcber die Massenmedien) von  Machtmissbrauch st\u00e4rkt jeden ungemein, der missbraucht wurde (egal ob  k\u00f6rperlich, psychisch oder sexuell). Das scheint Frau #Fla\u00dfp\u00f6hler zu \u00fcbersehen und bringt selbst keine Handlungsoptionen ein.","userId":108068653,"media":null,"username":"JulieAneT","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":4.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":20,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":4.0,"rollingSumOfClimate":0.0},{"id":"1048917912612995075","date":1538916492000,"rawContent":"#MeToo","userId":108068653,"media":null,"username":"JulieAneT","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":5.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":21,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":5.0,"rollingSumOfClimate":0.0},{"id":"1048981335690424320","date":1538931614000,"rawContent":"Das eigentliche Problem der strukturellen #Gewalt, um das es bei der #metoo-Debatte im Grunde geht, wurde am Schluss nur von einer Frau aus dem Publikum erkannt. #Fla\u00dfp\u00f6hler argumentiert zum Schluss immer frauenfeindlicher. #Empowerment sieht anders aus:\nhttps:\/\/t.co\/A58xxkldCS","userId":108068653,"media":null,"username":"JulieAneT","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"contain