[{"id":"1266199752909062144","date":1590720520000,"rawContent":"I see you. \nI hear you.\nI will fight for you in any way I can.\nI am with you. \n\n#BlackLivesMatter","userId":81982024,"media":null,"username":"VampireAngel91","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":1.0,"sumOfBlackLivesMatter":1,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":1.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1266555963080925184","date":1590805447000,"rawContent":"This isn't a whining post, btw. I'm just calling myself out for not being able to do more. \n\nTo my beautiful community: \n\nI stand in solidarity with you all. May justice be served and may the action of the people be what brings it to fruition.\n\nAll my love and blessings. \n\n#BLM","userId":81982024,"media":null,"username":"VampireAngel91","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":2.0,"sumOfBlackLivesMatter":2,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":2.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1275659835342835713","date":1592975980000,"rawContent":"I feel guilty for my tears, as someone would probably use them against me. But, I just can't stand it. #BlackLivesMatter","userId":81982024,"media":null,"username":"VampireAngel91","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":3.0,"sumOfBlackLivesMatter":3,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":3.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1275662499791155201","date":1592976615000,"rawContent":"Also, if you want to use my tears against me, fine. Call me whatever you want, but that doesn't mean that my heart isn't aching. I'm trying to be a better and more educated ally, and I don't think I should feel ashamed of that. \n\nSo, once again, I say: #BlackLivesMatter","userId":81982024,"media":null,"username":"VampireAngel91","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":4.0,"sumOfBlackLivesMatter":4,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":4.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0}]