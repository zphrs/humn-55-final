[{"id":"1014503492977856514","date":1530711455000,"rawContent":"A 22 year old Black man was killed by the French police in Nantes yesterday, and the media mentions neither racial profiling nor institutionalised police violence. #racismkills #blacklivesmatter \nhttps:\/\/t.co\/5JGZtbp0um","userId":1467225554,"media":null,"username":"EmiliaZenzile","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":1.0,"sumOfBlackLivesMatter":1,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":1.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1014503494999568384","date":1530711456000,"rawContent":"The widespread colorblindness that pervades French society invisibilizes structural and systemic racism and upholds the idea that racial profiling and police violence towards racial and disenfranchised minorities are necessary police practices #racismkills #blacklivesmatter","userId":1467225554,"media":null,"username":"EmiliaZenzile","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":2.0,"sumOfBlackLivesMatter":2,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":2.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1014503497180614656","date":1530711456000,"rawContent":"Also, mentioning the 'criminal' past of the deceased rather than focusing on the policemen's racial biases constitutes victim-blaming and legitimates police brutality\/crime. #racismkills #blacklivesmatter","userId":1467225554,"media":null,"username":"EmiliaZenzile","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":3.0,"sumOfBlackLivesMatter":3,"sumOfBlueLivesMatter":0,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackL