[{"id":"1042460991504539648","date":1537377043000,"rawContent":"LISTEN: @jonkay interviews @DaphneMerkin about Soon-Yi Previn and the online backlash generated by journalism which dissents from the #MeToo script https:\/\/t.co\/SXJbA43zQZ","userId":3775360879,"media":null,"username":"Quillette","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":1.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":13,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":1.0,"rollingSumOfClimate":0.0},{"id":"1043241499734024192","date":1537563130000,"rawContent":"\"Previn\u2019s treatment reveals two inherent contradictions in the #MeToo movement. The first is that #MeToo decrees that all women are victims (since all men are predators) thus denying them agency in their own stories.\"\nhttps:\/\/t.co\/Rh1JW4Ipxl","userId":3775360879,"media":null,"username":"Quillette","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":2.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":14,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":2.0,"rollingSumOfClimate":0.0},{"id":"1043511065840103424","date":1537627400000,"rawContent":"\"Ultimately, dividing the world into victims and villains, as #MeToo demands of us, fails to take into account the complexities of human nature.\"\nhttps:\/\/t.co\/Rh1JW4Ipxl","userId":3775360879,"media":null,"username":"Quillette","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":3.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":15,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":3.0,"rollingSumOfClimate":0.0},{"id":"10