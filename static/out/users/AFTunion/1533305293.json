r":0.0,"rollingSumOfMeToo":3.0,"rollingSumOfClimate":0.0},{"id":"1025387651988377600","date":1533306441000,"rawContent":"@mcricker .@mcricker shared how it's often men hiring females in schools and how over the years she's heard from female educators who are noting that their Principal was only hiring young females, which leads to many older educators being pushed out of the schools. #NN18 #MeToo","userId":45573874,"media":null,"username":"AFTunion","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":4.0,"sumOfBlackLivesMatter":45,"sumOfBlueLivesMatter":0,"sumOfMeToo":24,"sumOfClimate":1,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":4.0,"rollingSumOfClimate":0.0},{"id":"1025387912505053184","date":1533306503000,"rawContent":"@mcricker .@mcricker also noted how female educators also face discrimination in schools with the lack of pumping rooms. #NN18 #MeToo","userId":45573874,"media":null,"username":"AFTunion","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":5.0,"sumOfBlackLivesMatter":45,"sumOfBlueLivesMatter":0,"sumOfMeToo":25,"sumOfClimate":1,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":5.0,"rollingSumOfClimate":0.0},{"id":"1025391439562375169","date":1533307344000,"rawContent":"Educators need to study the curriculum that student's are being taught to see how it is a part of the conditioning of sexual assault, which also stems from depictions of harassment in films to the acceptability of the male gaze to the backlog of rape kits \u2014 @mcricker #NN18 #MeToo","userId":45573874,"media":null,"username":"AFTunion","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":6.0,"sumOfBlackLivesMatter":45,"sumOfBlueLivesMatter":0,"sumOfMeToo":26,