weetsPerMonth":6.0,"sumOfBlackLivesMatter":96,"sumOfBlueLivesMatter":1,"sumOfMeToo":14,"sumOfClimate":22,"rollingSumOfBlackLivesMatter":5.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":1.0,"rollingSumOfClimate":0.0},{"id":"1299428190327386115","date":1598642797000,"rawContent":"THIS is the scariest thing I\u2019ve seen all day. And everything that these psychos do will be blamed on #BlackLivesMatter","userId":16256826,"media":null,"username":"jodotcom","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":7.0,"sumOfBlackLivesMatter":97,"sumOfBlueLivesMatter":1,"sumOfMeToo":14,"sumOfClimate":22,"rollingSumOfBlackLivesMatter":6.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":1.0,"rollingSumOfClimate":0.0},{"id":"1300057117198561280","date":1598792745000,"rawContent":"#BlackLivesMatter  Please read this thread! It could save your life &amp; our country! \/\/ A Thread by @ClaireBerlinski: This report confirms there may be links to White supremacist groups among US law enforcement. It isn't clear on the details, but \u2026 https:\/\/t.co\/0yr3w6gMOf","userId":16256826,"media":null,"username":"jodotcom","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":6.0,"sumOfBlackLivesMatter":98,"sumOfBlueLivesMatter":1,"sumOfMeToo":14,"sumOfClimate":22,"rollingSumOfBlackLivesMatter":5.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":1.0,"rollingSumOfClimate":0.0},{"id":"1300059691205177344","date":1598793358000,"rawContent":"We know that it\u2019s not Black people, but Trump lies. He\u2019s blaming #BlackLivesMatter for the violence &amp; destruction. And unfortunately, too many voters believe him.\nLet\u2019s not give him ammunition.","userId":16256826,"media":null,"username":"jodotcom","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":7.0,"sumOfBlackLivesMatter":99,"sumOfBlueLivesMatter":1,"sumOfMeToo":14,"sumOfClimate":22,"rollingSumOfBlackLivesMatter":6.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":1.0,"rollingSumOfClimate":0.0},{"id":"1300064711497711617","date":1598794555000,"rawContent":"Not what I said. Peaceful protests should not stop. But should not be goaded into violence. Once looting &amp; destruction starts, sympathy for #BlackLivesMatter  dissolves. When Trump thugs show up, call it a day. No reason to stay all night.\nGood trouble.","userId":16256826,"media":null,"username":"jodotcom","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":8.0,"sumOfBlackLivesMatter":100,"sumOfBlueLivesMatter":1,"sumOfMeToo":14,"sumOfClimate":22,"rollingSumOfBlackLivesMatter":7.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":1.0,"rollingSumOfClimate":0.0},{"id":"1300124824044539905","date":1598808887000,"rawContent":"Vicky Osterweil nor Malcolm Harris do NOT speak for me. They sound like Trumpsters trying to mislead.\nLooting is NEVER encouraged. Indeed it does the opposite. #BlackLivesMatter is making great strides w\/ a positive message, which is diminished by looting, destruction &amp; violence.","userId":16256826,"media":null,"username":"jodotcom","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":9.0,"sumOfBlackLivesMatter":101,"sumOfBlueLivesMatter":1,"sumOfMeToo":14,"sumOfClimate":22,"rollingSumOfBlackLivesMatter":8.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":1.0,"rollingSumOfClimate":0.0},{"id":"1300806985965875203","date":1598971527000,"rawContent":"True. Antifa is a backlash to white supremacy. Trump tries to make Antifa into a bad thing, and, just as with #BlackLivesMatter they should remain peaceful protestors or they will diminish their cause.\nI am anti-fascist, as were those in my family who fought against them. https:\/\/t.co\/buTO48GwZ5","userId":16256826,"media":["https:\/\/pbs.twimg.com\/media\/Eg1lDw-XYAECR8l?format=jpg&name=orig"],"username":"jodotcom","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":10.0,"sumOfBlackLivesMatter":102,"sumOfBlueLivesMatter":1,"sumOfMeToo":14,"sumOfClimate":22,"rollingSumOfBlackLivesMatter":9.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":1.0,"rollingSumOfClimate":0.0},{"id":"1300933823341957120","date":1599001768000,"rawContent":"I think videos have shown that to be the case. In fact, #BlackLivesMatter protestors have followed them around trying to \u2018clean up\u2019 after them. One breaking windows of stores was even suspected to be a policeman.","userId":16256826,"media":null,"username":"jodotcom","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":11.0,"sumOfBlackLivesMatter":103,"sumOfBlueLivesMatter":1,"sumOfMeToo":14,"sumOfClimate":22,"rollingSumOfBlackLivesMatter":10.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":1.0,"rollingSumOfClimate":0.0},{"id":"1302612450370519041","date":1599401984000,"rawContent":"That #BlueLivesMatter flag came out as a backlash to #BlackLivesMatter . The people actively displaying those sign are Trumpsters who defend the police for killing unarmed black men. Thank you for putting out a POW\/MIA flag.","userId":16256826,"media":null,"username":"jodotcom","containsBlackLivesMatter":true,"containsBlueLivesMatter":true,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":12.0,"sumOfBlackLivesMatter":104,"sumOfBlueLivesMatter":2,"sumOfMeToo":14,"sumOfClimate":22,"rollingSumOfBlackLivesMatter":11.0,"rollingSumOfBlueLivesMatter":1.0,"rollingSumOfMeToo":1.0,"rollingSumOfClimate":0.0},{"id":"1302630767063961600","date":1599406351000,"rawContent":"#MeToo","userId":16256826,"m