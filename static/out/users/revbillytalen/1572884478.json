mate":14.0},{"id":"1210600390229667842","date":1577464599000,"rawContent":"HAPPY EARTHMAS. Soon, Christmas culture flips over. No plastic in gifts. No pesticides or guns. We have living Earth in our gifts. We practice giving life to life. #TakePlasticBackFriday #StopShopping #ClimateCrisis #ActOnClimate #BreakFreeFromPlastic #FridaysForFuture","userId":22320092,"media":null,"username":"revbillytalen","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":true,"rollingTweetsPerMonth":15.0,"sumOfBlackLivesMatter":93,"sumOfBlueLivesMatter":0,"sumOfMeToo":1,"sumOfClimate":85,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":15.0},{"id":"1210604039345451008","date":1577465469000,"rawContent":"\"People in the U.S. are throwing out over 60 pounds of clothes a year. It has reached a point where 60% of all global greenhouse gasses comes from household consumption.\" Read more: https:\/\/t.co\/x0uOM9vLAv #StopShopping #ClimateCrisis #ActOnClimate #TakePlasticBackFriday","userId":22320092,"media":null,"username":"revbillytalen","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":true,"rollingTweetsPerMonth":16.0,"sumOfBlackLivesMatter":93,"sumOfBlueLivesMatter":0,"sumOfMeToo":1,"sumOfClimate":86,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":16.0},{"id":"1210605891743109128","date":1577465911000,"rawContent":"HAPPY EARTHMAS! The planet overheats everywhere. Like all animals we flee the fires and floods. We also flee from old ideas. Extinction silences life around me. What am I learning? #TakePlasticBackFriday #StopShopping #ClimateCrisis #ActOnClimate","userId":22320092,"media":null,"username":"revbillytalen","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":true,"rollingTweetsPerMonth":17.0