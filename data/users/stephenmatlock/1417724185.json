sMatter":2,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":2.0,"rollingSumOfBlueLivesMatter":2.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"543775871073398788","date":1418481245000,"rawContent":"Because if we hold cops accountable for killing unarmed black Americans, America will fall apart. #BlueLivesMatter.","media":null,"username":"stephenmatlock","containsBlackLivesMatter":false,"containsBlueLivesMatter":true,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":5.0,"sumOfBlackLivesMatter":2,"sumOfBlueLivesMatter":3,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":2.0,"rollingSumOfBlueLivesMatter":3.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"543777708304375809","date":1418481683000,"rawContent":"So white America rallies behind #BlueLivesMatter and cops who show that #BlackLivesDontMatter. So back to normal, I guess.","media":null,"username":"stephenmatlock","containsBlackLivesMatter":false,"containsBlueLivesMatter":true,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":6.0,"sumOfBlackLivesMatter":2,"sumOfBlueLivesMatter":4,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":2.0,"rollingSumOfBlueLivesMatter":4.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"543782392490512384","date":1418482800000,"rawContent":"Cops must be free to kill, beat, and maim without repercussions, else civilization ends. #BlueLivesMatter","media":null,"username":"stephenmatlock","containsBlackLivesMatter":false,"containsBlueLivesMatter":true,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":7.0,"sumOfBlackLivesMatter":2,"sumOfBlueLivesMatter":5,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":2.0,"rollingSumOfBlueLivesMatter":5.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"543782563852984320","date":1418482840000,"rawContent":"Those who enforce the law must be free of the law's constraints. #BlueLivesMatter","media":null,"username":"stephenmatlock","containsBlackLivesMatter":false,"containsBlueLivesMatter":true,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":8.0,"sumOfBlackLivesMatter":2,"sumOfBlueLivesMatter":6,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":2.0,"rollingSumOfBlueLivesMatter":6.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"543788801538011136","date":1418484328000,"rawContent":"The best way to promote #BlueLivesMatter is to hold cops accountable for their illegal actions.","media":null,"username":"stephenmatlock","containsBlackLivesMatter":false,"containsBlueLivesMatter":true,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":9.0,"sumOfBlackLivesMatter":2,"sumOfBlueLivesMatter":7,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":2.0,"rollingSumOfBlueLivesMatter":7.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"543807291539996672","date":1418488736000,"rawContent":"Cops protected by custom &amp; law. Black Americans protected by -- I'm kidding. They're not protected. #BlueLivesMatter when #BlackLivesMatter","media":null,"username":"stephenmatlock","containsBlackLivesMatter":true,"containsBlueLivesMatter":true,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":10.0,"sumOfBlackLivesMatter":3,"sumOfBlueLivesMatter":8,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":3.0,"rollingSumOfBlueLivesMatter":8.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"543808626209480705","date":1418489054000,"rawContent":"When good cops don't speak out about bad cops, how do we know they're good cops? #BlueLivesMatter is a tag for a problem that doesn't exist.","media":null,"username":"stephenmatlock","containsBlackLivesMatter":false,"containsBlueLivesMatter":true,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":11.0,"sumOfBlackLivesMatter":3,"sumOfBlueLivesMatter":9,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":3.0,"rollingSumOfBlueLivesMatter":9.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"543811569428078594","date":1418489756000,"rawContent":"#TamirRice #EricGarner #MikeBrown killers were cops. #BlueLivesMatter is the wrong tag--should be #BlueLivesMatterMore","media":null,"username":"stephenmatlock","containsBlackLivesMatter":false,"containsBlueLivesMatter":true,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":12.0,"sumOfBlackLivesMatter":3,"sumOfBlueLivesMatter":10,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":3.0,"rollingSumOfBlueLivesMatter":10.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"543812775131115520","date":1418490043000,"rawContent":"#BlueLivesMatter is the same as #WaterIsWet. Well, yeah. Consequence-free killing and beating even when caught on video.","media":null,"username":"stephenmatlock","containsBlackLivesMatter":false,"containsBlueLivesMatter":true,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":13.0,"sumOfBlackLivesMatter":3,"sumOfBlueLivesMatter":11,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":3.0,"rollingSumOfBlueLivesMatter":11.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"543815685155991552","date":1418490737000,"rawContent":"#NotAllCops are bad. Most aren't, in fact. But they're silent about the bad ones. Why? #BlueLivesMatter is a tag for a non-existent problem.","media":null,"username":"stephenmatlock","containsBlackLivesMatter":false,"containsBlueLivesMatter":true,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":14.0,"sumOfBlackLivesMatter":3,"sumOfBlueLivesMatter":12,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":3.0,"rollingSumOfBlueLivesMatter":12.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"543861735430447104","date":1418501716000,"rawContent":"I can't tell the good cops from the bad cops, because the good cops don't speak out #BlueLivesMatter is a tag without a problem behind it.","media":null,"username":"stephenmatlock","containsBlackLivesMatter":false,"containsBlueLivesMatter":true,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":15.0,"sumOfBlackLivesMatter":3,"sumOfBlueLivesMatter":13,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":3.0,"rollingSumOfBlueLivesMatter":13.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"543926038028226560","date":1418517047000,"rawContent":"Dear White People: We don't have to have our own tag because we always matter. #BlackLivesMatter points out something we ignore.","media":null,"username":"stephenmatlock","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":16.0,"sumOfBlackLivesMatter":4,"sumOfBlueLivesMatter":13,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":4.0,"rollingSumOfBlueLivesMatter":13.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"543926402446143488","date":1418517134000,"rawContent":"The same cops who enforce the law must also be accountable to that law, else #BlueLivesMatter is meaningless.","media":null,"username":"stephenmatlock","containsBlackLivesMatter":false,"containsBlueLivesMatter":true,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":17.0,"sumOfBlackLivesMatter":4,"sumOfBlueLivesMatter":14,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":4.0,"rollingSumOfBlueLivesMatter":14.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"543927297225408512","date":1418517347000,"rawContent":"It's possible to demand that cops be prosecuted for lawbreaking and still support cops. We are a nation of laws. #BlueLivesMatter means that","media":null,"username":"stephenmatlock","containsBlackLivesMatter":false,"containsBlueLivesMatter":true,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":18.0,"sumOfBlackLivesMatter":4,"sumOfBlueLivesMatter":15,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":4.0,"rollingSumOfBlueLivesMatter":15.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"543935936929619968","date":1418519407000,"rawContent":"Black Americans to cops: Don't send me to my own funeral. #BlackLivesMatter","media":null,"username":"stephenmatlock","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":19.0,"sumOfBlackLivesMatter":5,"sumOfBlueLivesMatter":15,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":5.0,"rollingSumOfBlueLivesMatter":15.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"544166063395442688","date":1418574274000,"rawContent":"Cops are not above the law, and should be accountable to the law. Else #BlueLivesMatter is an unneeded hashtag.","media":null,"username":"stephenmatlock","containsBlackLivesMatter":false,"containsBlueLivesMatter":true,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":20.0,"sumOfBlackLivesMatter":5,"sumOfBlueLivesMatter":16,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":5.0,"rollingSumOfBlueLivesMatter":16.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"544398772118110208","date":1418629756000,"rawContent":"Apparently LEOs, armed with guns, have such fragile egos and hair-trigger tempers that we cannot criticize their actions. #BlackLivesMatter","media":null,"username":"stephenmatlock","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":21.0,"sumOfBlackLivesMatter":6,"sumOfBlueLivesMatter":16,"sumOfMeToo":0,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":6.0,"rollingSumOfBlueLivesMatter":16.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"548990663090372609","date":1419724548000,"rawContent":"Mostly white police CAN protest AT a funeral for cops, but mostly non-white citizens CANNOT protest anywhere else? #BlackLivesMatter","media":n