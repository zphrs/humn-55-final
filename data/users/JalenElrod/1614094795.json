[{"id":"1364238565698322435","date":1614094795000,"rawContent":"One year ago today.\n#AhmaudArbery \n#BlackLivesMatter","media":null,"username":"JalenElrod","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":1.0,"sumOfBlackLivesMatter":192,"sumOfBlueLivesMatter":2,"sumOfMeToo":14,"sumOfClimate":6,"rollingSumOfBlackLivesMatter":1.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1364985618762186757","date":1614272906000,"rawContent":"#JusticeForGeorgeFloyd\n#BlackLivesMatter","media":null,"username":"JalenElrod","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":2.0,"sumOfBlackLivesMatter":193,"sumOfBlueLivesMatter":2,"sumOfMeToo":14,"sumOfClimate":6,"rollingSumOfBlackLivesMatter":2.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1367930776709382145","date":1614975086000,"rawContent":"#BlackLivesMatter is a movement and an organization and you should only rock with the former.\nOver $90 million was raised off the backs of murdered Black people last year and there\u2019s been no accountability. To the contrary, it\u2019s just being exploitive in some capacities.","media":null,"username":"JalenElrod","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":3.0,"sumOfBlackLivesMatter":194,"sumOfBlueLivesMatter":2,"sumOfMeToo":14,"sumOfClimate":6,"rollingSumOfBlackLivesMatter":3.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1372742802514251778","date":1616122363000,"rawContent":"@oshunsdawta I think it can be described in a while that\u2019s akin to the Civil Rights Movement. Or arguably a continuation of it.\n#BlackLivesMatter as an organization never had any accountability and, honestly, too people profiting from systemic racism in ways we don\u2019t often discuss.","media":null,"username":"JalenElrod","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":4.0,"sumOfBlackLivesMatter":195,"sumOfBlueLivesMatter":2,"sumOfMeToo":14,"sumOfClimate":6,"rollingSumOfBlackLivesMatter":4.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1372829212441243649","date":1616142964000,"rawContent":"Watched #FalconAndTheWinterSoldier and the groundwork is being laid to show how the nation would react to the embodiment of America itself being a Black man. \nReading the comic at the height of the #BlackLivesMatter movement made me ask myself what it means to be an American. https:\/\/t.co\/0XyoPmTZ4I","media":[{"thumbnailUrl":"https:\/\/pbs.twimg.com\/tweet_video_thumb\/Ew1E4_AXMAERONo.jpg","variants":["https:\/\/video.twimg.com\/tweet_video\/Ew1E4_AXMAERONo.mp4"]}],"username":"JalenElrod","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":5.0,"sumOfBlackLivesMatter":196,"sumOfBlueLivesMatter":2,"sumOfMeToo":14,"sumOfClimate":6,"rollingSumOfBlackLivesMatter":5.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1381761651117023234","date":1618272624000,"rawContent":"Yep.\nThey meant to pay but their wallet was on the wrong side.\n#JusticeForDaunteWright\n#BlackLivesMatter","media":null,"username":"JalenElrod","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":3.0,"sumOfBlackLivesMatter":197,"sumOfBlueLivesMatter":2,"sumOfMeToo":14,"sumOfClimate":6,"rollingSumOfBlackLivesMatter":3.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1381821140591644674","date":1618286807000,"rawContent":"Officer Kim Potter murdered Daunte Wright.\nShe is the president of the local police union in Brooklyn Center. The leader of the police union that protects police who abuse their power at the expense of those they are sworn to protect.\n#JusticeForDaunteWright\n#BlackLivesMatter","media":null,"username":"JalenElrod","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":4.0,"sumOfBlackLivesMatter":198,"sumOfBlueLivesMatter":2,"sumOfMeToo":14,"sumOfClimate":6,"rollingSumOfBlackLivesMatter":4.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1382753384223084549","date":1618509071000,"rawContent":"Ok. This is getting out of had.\nWe really need to talk about how #BlackLivesMatter (the organization, not the movement) is exploitive and benefits from the suffering of Black families.\nThe mothers of those unjustly murdered have been too outspoken for this to continue.","media":null,"username":"JalenElrod","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":5.0,"sumOfBlackLivesMatter":199,"sumOfBlueLivesMatter":2,"sumOfMeToo":14,"sumOfClimate":6,"rollingSumOfBlackLivesMatter":5.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1382923234753060864","date":1618549567000,"rawContent":"This column about #BlackLivesMatter is needed now. \nWe really need to talk about how the organization (not the movement) is exploitive and financially benefits from murdered Black bodies.\nYet the families of these victims receive nothing. Activism should not be a racket.","media":null,"username":"JalenElrod","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":6.0,"sumOfBlackLivesMatter":200,"sumOfBlueLivesMatter":2,"sumOfMeToo":14,"sumOfClimate":6,"rollingSumOfBlackLivesMatter":6.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1383183815217139715","date":1618611694000,"rawContent":"I view being patriotic and the #BlackLivesMatter movement as synonymous.\nThose protesters make this nation better with every step they take.","media":null,"username":"JalenElrod","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":7.0,"sumOfBlackLivesMatter":201,"sumOfBlueLivesMatter":2,"sumOfMeToo":14,"sumOfClimate":6,"rollingSumOfBlackLivesMatter":7.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1384617381910261761","date":1618953483000,"rawContent":"Justice has been served.\n\nI have to admit I was pleasantly surprised by the verdict. We\u2019ve seen justice denied too many times before.\n\nPray for the Floyd family and others who were taken by police brutality.\n\nBecause the work of ensuring #BlackLivesMatter persists.","media":null,"username":"JalenElrod","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":6.0,"sumOfBlackLivesMatter":202,"sumOfBlueLivesMatter":2,"sumOfMeToo":14,"sumOfClimate":6,"rollingSumOfBlackLivesMatter":6.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0}]