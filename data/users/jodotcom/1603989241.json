[{"id":"1321852800121344001","date":1603989241000,"rawContent":"I thought Canada was better than this. Or is it just that the police are bullies all over the world? Sad. #BlackLivesMatter #Calgary is off my travel list.","media":null,"username":"jodotcom","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":1.0,"sumOfBlackLivesMatter":105,"sumOfBlueLivesMatter":2,"sumOfMeToo":15,"sumOfClimate":22,"rollingSumOfBlackLivesMatter":1.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1324147421526544384","date":1604536321000,"rawContent":"Worst slogan ever. It totally diminished the brilliant success of the #BlackLivesMatter movement.\nWe need law enforcement!but we need to root out white supremacists, hire honest caring ppl from local neighborhoods, retrain &amp; reform them.","media":null,"username":"jodotcom","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":2.0,"sumOfBlackLivesMatter":106,"sumOfBlueLivesMatter":2,"sumOfMeToo":15,"sumOfClimate":22,"rollingSumOfBlackLivesMatter":2.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1326268961244241920","date":1605042135000,"rawContent":"I said it was stupid the first time I heard it. It totally diminished the brilliant (until those chants began) .#BlackLivesMatter  movement.\nWe need law enforcement! We must eliminate white Supremacists, give lots more training &amp; not allow good apples to cover for bad apples.","media":null,"username":"jodotcom","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":3.0,"sumOfBlackLivesMatter":107,"sumOfBlueLivesMatter":2,"sumOfMeToo":15,"sumOfClimate":22,"rollingSumOfBlackLivesMatter":3.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1326380545476079624","date":1605068739000,"rawContent":"I did immediately. But no one heard me, and it went on for weeks. I blame someone who wanted to diminish the brilliant #BlackLivesMatter movement.","media":null,"username":"jodotcom","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":4.0,"sumOfBlackLivesMatter":108,"sumOfBlueLivesMatter":2,"sumOfMeToo":15,"sumOfClimate":22,"rollingSumOfBlackLivesMatter":4.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1326522787545100290","date":1605102652000,"rawContent":".. and they did exactly that. The \u2018debate\u2019 over \u2018defunding the police\u2019 took over the spotlight &amp; diminished the #BlackLivesMatter movement. It worked great for the #GOP.","media":null,"username":"jodotcom","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":5.0,"sumOfBlackLivesMatter":109,"sumOfBlueLivesMatter":2,"sumOfMeToo":15,"sumOfClimate":22,"rollingSumOfBlackLivesMatter":5.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1328206910382895110","date":1605504178000,"rawContent":"Another reason to hate Trump &amp; his MAGAs. I guess they just can\u2019t say, \u201cThank you for your service.\u201d Sad. #BlackLivesMatter","media":null,"username":"jodotcom","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":6.0,"sumOfBlackLivesMatter":110,"sumOfBlueLivesMatter":2,"sumOfMeToo":15,"sumOfClimate":22,"rollingSumOfBlackLivesMatter":6.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1329884959939694595","date":1605904257000,"rawContent":"I am NOT in favor of defunding the police. It was a really stupid &amp; dangerous slogan that diminished the  #BlackLivesMatter movement.\nYes, boot the crooked ones &amp; those who cover up for them, retrain them so \u2018shoot to kill\u2019 is NOT all they know to do. But we need law enforcement.","media":null,"username":"jodotcom","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":7.0,"sumOfBlackLivesMatter":111,"sumOfBlueLivesMatter":2,"sumOfMeToo":15,"sumOfClimate":22,"rollingSumOfBlackLivesMatter":7.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1329886883221016579","date":1605904715000,"rawContent":"#BlackLivesMatter covered that nicely.","media":null,"username":"jodotcom","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":8.0,"sumOfBlackLivesMatter":112,"sumOfBlueLivesMatter":2,"sumOfMeToo":15,"sumOfClimate":22,"rollingSumOfBlackLivesMatter":8.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0},{"id":"1334234802686464000","date":1606941340000,"rawContent":"The \u2018demilitarize\u2019 slogan would\u2019ve made sense &amp; needed no round-about, long-winded explanation.\nWhoever came up with \u2018defund\u2019 didn\u2019t think it through &amp; did a great disservice to the brilliant #BlackLivesMatter movement.","media":null,"username":"jodotcom","containsBlackLivesMatter":true,"containsBlueLivesMatter":false,"containsMeToo":false,"containsClimate":false,"rollingTweetsPerMonth":8.0,"sumOfBlackLivesMatter":113,"sumOfBlueLivesMatter":2,"sumOfMeToo":15,"sumOfClimate":22,"rollingSumOfBlackLivesMatter":8.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":0.0,"rollingSumOfClimate":0.0}]