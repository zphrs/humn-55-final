[{"id":"1041644735998423040","date":1537182432000,"rawContent":"@MrsSpaceCowboy Me too, sister. #MeToo","media":null,"username":"BellaDCullen","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":1.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":3,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":1.0,"rollingSumOfClimate":0.0},{"id":"1041715426378620928","date":1537199286000,"rawContent":"The first time I was sexually assaulted I was 11. It was 1985. I told an adult &amp; nothing happened. The second time I was assaulted I was 12. I told 2 adults &amp; nothing happened. I was the victim of date rape when I was 17. I told no one &amp; blamed myself for years. #MeToo","media":null,"username":"BellaDCullen","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":2.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":4,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":2.0,"rollingSumOfClimate":0.0},{"id":"1042121448201105408","date":1537296089000,"rawContent":"@laurakayeauthor ... and then finally hit send. #MeToo","media":null,"username":"BellaDCullen","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":3.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":5,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":3.0,"rollingSumOfClimate":0.0},{"id":"1042373248485388288","date":1537356123000,"rawContent":"Sexual assault isn\u2019t something that stopped happening 35 years ago. We need to do the right thing for the teenagers assaulted last weekend, last night. It isn\u2019t rough horseplay. Once is one too many times. Perpetrators should be held accountable always. #MeToo","media":null,"username":"BellaDCullen","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":4.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":6,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":4.0,"rollingSumOfClimate":0.0},{"id":"1045015276625031168","date":1537986032000,"rawContent":"I told my husband vague details about sexual assault over the years. It wasn\u2019t until the #MeToo movement that I told him in detail. It wasn\u2019t until earlier this year that I used the words date rape. Waiting decades is the norm, not the exception.","media":null,"username":"BellaDCullen","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":5.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":7,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":5.0,"rollingSumOfClimate":0.0}]