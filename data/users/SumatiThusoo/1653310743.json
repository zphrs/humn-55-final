[{"id":"1528722175166779392","date":1653310743000,"rawContent":"\u201cHeard\u2019s tormentors, many of them young women, do not seem to see themselves as anti-feminist. They believe women, of course \u2013 just not this one.\nIt is not they who are damaging #MeToo, it is Heard \u2013 by virtue of being an imperfect victim.\u201d","media":null,"username":"SumatiThusoo","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":1.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":2,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":1.0,"rollingSumOfClimate":0.0},{"id":"1528722381396508672","date":1653310792000,"rawContent":"\u201cThey perhaps forget that the project of #MeToo \u2013 the whole point \u2013 was to help imperfect victims.\u201d","media":null,"username":"SumatiThusoo","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":2.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":3,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":2.0,"rollingSumOfClimate":0.0},{"id":"1528723553155133441","date":1653311072000,"rawContent":"\u201cWhether or not Heard\u2019s accusers fully realise it then, setting up \u201cbad\u201d victims in opposition to \u201cgenuine\u201d ones is a very effective method of unpicking #MeToo.\u201d","media":null,"username":"SumatiThusoo","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":3.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":4,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":3.0,"rollingSumOfClimate":0.0},{"id":"1528724102134976513","date":1653311202000,"rawContent":"\u201c#MeToo is often framed as having uncovered truths about the world \u2013 its success was because women \u201cexplained really clearly\u201d what was going on. No. People already knew what was going on.\u201d","media":null,"username":"SumatiThusoo","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":4.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":5,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":4.0,"rollingSumOfClimate":0.0},{"id":"1528724213774704643","date":1653311229000,"rawContent":"\u201c#MeToo worked for the reason any feminist movement works: strength in numbers. It is a political movement pushing against incredibly strong forces in the other direction. There\u2019s no reason to think its work cannot be rolled back.\u201d","media":null,"username":"SumatiThusoo","containsBlackLivesMatter":false,"containsBlueLivesMatter":false,"containsMeToo":true,"containsClimate":false,"rollingTweetsPerMonth":5.0,"sumOfBlackLivesMatter":0,"sumOfBlueLivesMatter":0,"sumOfMeToo":6,"sumOfClimate":0,"rollingSumOfBlackLivesMatter":0.0,"rollingSumOfBlueLivesMatter":0.0,"rollingSumOfMeToo":5.0,"rollingSumOfClimate":0.0}]